# =============================================================
# Discord Stream Activity — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# ---- Discord Application ----------------------------------------
# Create your app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ---- LiveKit SFU ------------------------------------------------
# Self-hosted (docker-compose) or LiveKit Cloud (https://livekit.io)
# URL to connect to LiveKit from the server (can be internal Docker URL if self-hosted)
LIVEKIT_URL=ws://localhost:7880
# URL to connect to LiveKit from the Discord Activity (proxy URL or public URL)
LIVEKIT_PUBLIC_URL=wss://your-livekit-public-url
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_in_production

# ---- API Server -------------------------------------------------
PORT=3000
NODE_ENV=development
# Restrict in production to your actual Activity URL
CORS_ORIGIN=https://discord.com

# Token TTL in seconds (how long LiveKit participant tokens are valid)
LIVEKIT_TOKEN_TTL=3600

# ---- Frontend (Vite) --------------------------------------------
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here
# External transmitter app URL (local dev: port 5174, production: Vercel URL)
VITE_TRANSMITTER_URL=http://localhost:5174
# Direct LiveKit Cloud URL for the external transmitter (runs outside Discord proxy)
VITE_LIVEKIT_DIRECT_URL=wss://your-livekit-public-url
